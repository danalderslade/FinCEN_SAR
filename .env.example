# ── Database ──────────────────────────────────────────────────
POSTGRES_DB=fincen_sar
POSTGRES_USER=saruser
POSTGRES_PASSWORD=CHANGE_ME

# ── Spring Boot API ──────────────────────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/fincen_sar
DB_USERNAME=saruser
DB_PASSWORD=CHANGE_ME
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SPRING_PROFILES_ACTIVE=default

# ── JWT ──────────────────────────────────────────────────────
# Must be >= 256 bits (32+ characters). Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRATION_MS=86400000
